# Bytecode / cache do Python
__pycache__/
*.py[cod]
*$py.class

# Ambientes virtuais
venv/
.venv/
env/

# Configuração local (contém o token do Módulo 3)
.env

# Dados gerados em runtime (não fazem parte do código-fonte)
data.json
data.json.tmp
resultados.csv
comandos/
state.json
data

# Configuração local do Streamlit (pode conter tokens/preferências da máquina)
.streamlit/*
!.streamlit/config.toml

# Editor / SO
.vscode/
.idea/
.DS_Store
