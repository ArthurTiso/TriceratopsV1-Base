# Copie para .env (na raiz do projeto) e ajuste. O .env não é versionado.

# Equipe cujo ensaio está sendo transmitido (precisa estar aprovada no Módulo 3).
# Nos dados de demonstração do Módulo 3: MOCK001, MOCK002, MOCK003 ou MOCK004.
SPINO_TEAM_CODE=MOCK001

# Endereço do Módulo 3. Use o IP do computador/servidor quando o Módulo 2
# estiver no Raspberry.
SPINO_MODULO3_URL=http://localhost:8000/api/v1/sensors/capture
# Mesmo valor de SENSORS_API_TOKEN no .env do Módulo 3.
SPINO_MODULO3_TOKEN=troque-por-o-mesmo-token-do-modulo-3

# Frequência máxima de amostras HTTP; a leitura do Módulo 1 continua a 2 quadros/s.
SPINO_SEND_INTERVAL_SECONDS=1

# Origem dos quadros: "simulador" ou "serial" (Arduino receptor via USB).
SPINO_RECEIVER=serial
# Porta do Arduino receptor: COM3 (Windows), /dev/ttyACM0 ou /dev/ttyUSB0 (Pi).
SPINO_SERIAL_PORT=COM3
SPINO_SERIAL_BAUD=9600

# Simulador: "atual" (flag 1 durante todo o ensaio, firmware de hoje) ou
# "corrigido" (flag 0 durante o ensaio e 1 só no colapso).
SPINO_SIM_FIRMWARE=atual
# Fração de quadros perdidos no rádio simulado (0 a 1).
SPINO_SIM_PERDA_RF=0

# Porta do mock do Módulo 3 (python -m sender.mock_modulo3_server).
SPINO_MOCK_PORT=8000
