# Identificação da equipe cujo ensaio está sendo transmitido.
SPINO_TEAM_CODE=APITEST01

# Use o IP do computador/servidor quando o Módulo 2 estiver no Raspberry.
SPINO_MODULO3_URL=http://192.168.1.10:8000/api/v1/sensors/capture
SPINO_MODULO3_TOKEN=troque-por-o-mesmo-token-do-modulo-3

# Frequência máxima de amostras HTTP; a leitura RF continua na frequência nativa.
SPINO_SEND_INTERVAL_SECONDS=1
