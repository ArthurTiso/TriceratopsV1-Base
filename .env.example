# Copie para .env (na raiz do projeto) e ajuste. O .env não é versionado.

# Porta USB do Arduino do Módulo 1: Gerenciador de Dispositivos → Portas (COM e LPT).
SPINO_RECEIVER=serial
SPINO_SERIAL_PORT=COM3
SPINO_SERIAL_BAUD=115200
# Use SPINO_RECEIVER=simulador para testar sem a balança.

# Equipe usada quando o comando "novo" é digitado sem código (opcional).
SPINO_TEAM_CODE=MOCK001

# Endereço do Módulo 3 e o mesmo valor de SENSORS_API_TOKEN do .env dele.
SPINO_MODULO3_URL=http://127.0.0.1:8000/api/v1/sensors/capture
SPINO_MODULO3_TOKEN=troque-por-o-mesmo-token-do-modulo-3

# Intervalo mínimo entre amostras enviadas ao Módulo 3 (segundos).
SPINO_SEND_INTERVAL_SECONDS=1

# Detecção de colapso: carga <= FRACAO x pico, com pico >= PESO_MINIMO,
# mantida por CONFIRMACAO segundos.
SPINO_COLAPSO_PESO_MINIMO_KG=2.0
SPINO_COLAPSO_FRACAO=0.20
SPINO_COLAPSO_CONFIRMACAO_S=1.0

# Porta do mock do Módulo 3 (python -m sender.mock_modulo3_server).
SPINO_MOCK_PORT=8000
